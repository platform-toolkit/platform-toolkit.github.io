{
  "$schema": "https://json.schemastore.org/tsconfig",

  // Storybook's configuration and every story, checked with the same strictness
  // as shipped code. They are excluded from the package projects so that `dist`
  // contains what the site loads and nothing else, which would otherwise leave
  // them unchecked entirely -- and a story that no longer compiles is
  // documentation asserting an interface the component does not have.
  //
  // `.storybook/main.ts` runs in Node and the stories run in a browser, so this
  // config carries both libraries. That is the same compromise `tsconfig.tests.json`
  // makes, and for the same reason: splitting it would buy one true statement
  // about two small files.
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    // `vite/client` is what declares a side-effect `.css` import as legal. The
    // preview imports the token stylesheet the same way every page does, and
    // without this the type checker reports it as a module with no declarations.
    "types": ["node", "vite/client"],

    "noEmit": true,
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "incremental": false,

    // Resolve workspace imports to source rather than to built output, so a
    // story type-checks on a clean checkout before anything has been compiled.
    // Storybook itself still loads the built packages -- see the note in
    // `.storybook/main.ts` about why that difference is deliberate.
    "paths": {
      "@platform-toolkit/configuration": ["./packages/configuration/src/index.ts"],
      "@platform-toolkit/data-access": ["./packages/data-access/src/index.ts"],
      "@platform-toolkit/convert": ["./packages/convert/src/index.ts"],
      "@platform-toolkit/convert/element": ["./packages/convert/src/element/index.ts"],
      "@platform-toolkit/data-contracts": ["./packages/data-contracts/src/index.ts"],
      "@platform-toolkit/domain": ["./packages/domain/src/index.ts"],
      "@platform-toolkit/ingestion": ["./packages/ingestion/src/index.ts"],
      "@platform-toolkit/preferences": ["./packages/preferences/src/index.ts"],
      "@platform-toolkit/qualification-check": ["./packages/qualification-check/src/index.ts"],
      "@platform-toolkit/qualification-check/element": [
        "./packages/qualification-check/src/element/index.ts"
      ],
      "@platform-toolkit/training-logbook": ["./packages/training-logbook/src/index.ts"],
      "@platform-toolkit/training-logbook/element": [
        "./packages/training-logbook/src/element/index.ts"
      ],
      "@platform-toolkit/training-logbook/handoff": ["./packages/training-logbook/src/handoff.ts"],
      "@platform-toolkit/ui": ["./packages/ui/src/index.ts"],
      "@platform-toolkit/ui/deep-text": ["./packages/ui/src/deep-text.ts"],
      "@platform-toolkit/ui/embed-height": ["./packages/ui/src/embed-height.ts"],
      "@platform-toolkit/ui/field-reading": ["./packages/ui/src/field-reading.ts"],
      "@platform-toolkit/ui/ptk-button": ["./packages/ui/src/ptk-button.ts"],
      "@platform-toolkit/ui/ptk-choice-group": ["./packages/ui/src/ptk-choice-group.ts"],
      "@platform-toolkit/ui/ptk-copy-button": ["./packages/ui/src/ptk-copy-button.ts"],
      "@platform-toolkit/ui/ptk-date-field": ["./packages/ui/src/ptk-date-field.ts"],
      "@platform-toolkit/ui/ptk-disclosure": ["./packages/ui/src/ptk-disclosure.ts"],
      "@platform-toolkit/ui/ptk-equipment-setup": ["./packages/ui/src/ptk-equipment-setup.ts"],
      "@platform-toolkit/ui/ptk-notice": ["./packages/ui/src/ptk-notice.ts"],
      "@platform-toolkit/ui/ptk-number-field": ["./packages/ui/src/ptk-number-field.ts"],
      "@platform-toolkit/ui/ptk-plate-stack": ["./packages/ui/src/ptk-plate-stack.ts"],
      "@platform-toolkit/ui/ptk-segmented": ["./packages/ui/src/ptk-segmented.ts"],
      "@platform-toolkit/ui/ptk-select": ["./packages/ui/src/ptk-select.ts"],
      "@platform-toolkit/ui/ptk-text-area": ["./packages/ui/src/ptk-text-area.ts"],
      "@platform-toolkit/ui/ptk-text-field": ["./packages/ui/src/ptk-text-field.ts"],
      "@platform-toolkit/ui/ptk-toggle-group": ["./packages/ui/src/ptk-toggle-group.ts"],
      "@platform-toolkit/ui/theme": ["./packages/ui/src/theme.ts"]
    }
  },
  "include": [
    ".storybook/**/*.ts",
    "packages/*/src/**/*.stories.ts",
    "apps/web/src/**/*.stories.ts"
  ]
}
