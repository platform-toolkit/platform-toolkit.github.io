# The `engines` field is advisory by default. This makes it binding, so an
# install on the wrong Node version fails immediately with a clear message
# rather than succeeding and failing later somewhere less obvious.
engine-strict=true

# Pin exact versions on `pnpm add <pkg>`. Toolchain drift between a local
# machine and CI is a real source of "works here, fails there".
save-exact=true

# Pin the public registry explicitly. Machines used for this project may have a
# private mirror configured globally, and installing through one would rewrite
# resolution URLs in the lockfile to an internal hostname -- committing a
# reference this repository is required not to contain, in a generated file
# nobody reads during review.
registry=https://registry.npmjs.org/

# Refuse to install on an unmet peer dependency rather than warning and carrying
# on. npm errors on these by default and pnpm does not, so without this the move
# to pnpm would quietly weaken an existing check: an incompatible TypeScript
# major was caught precisely because the install failed, instead of producing a
# tree whose type checker and lint plugin disagreed about the language version.
strict-peer-dependencies=true
