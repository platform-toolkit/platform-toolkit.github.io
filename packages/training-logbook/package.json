{
  "name": "@platform-toolkit/training-logbook",
  "version": "0.0.0",
  "private": true,
  "description": "Plan a session, log what you actually lifted, and keep the record on your own device.",
  "license": "Apache-2.0",
  "type": "module",
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "default": "./dist/core/index.js"
    },
    "./element": {
      "types": "./dist/element/index.d.ts",
      "default": "./dist/element/index.js"
    },
    "./handoff": {
      "types": "./dist/handoff.d.ts",
      "default": "./dist/handoff.js"
    },
    "./storage": {
      "types": "./dist/storage/index.d.ts",
      "default": "./dist/storage/index.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "default": "./dist/types.js"
    }
  },
  "scripts": {
    "build": "tsc --build"
  },
  "dependencies": {
    "@platform-toolkit/domain": "workspace:*",
    "@platform-toolkit/ui": "workspace:*",
    "lit": "3.3.3",
    "valibot": "1.4.2"
  }
}
