{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "rootDir": "./src",
    "outDir": "./dist"
  },
  "include": ["src/**/*.ts"],
  // Stories are excluded for the same reason tests are: `dist` should contain what
  // the site loads and nothing else. They are type-checked by `tsconfig.stories.json`.
  "exclude": ["src/**/*.test.ts", "src/**/*.stories.ts"],
  "references": [{ "path": "../configuration" }, { "path": "../domain" }]
}
