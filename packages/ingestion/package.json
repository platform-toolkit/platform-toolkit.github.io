{
  "name": "@platform-toolkit/ingestion",
  "version": "0.0.0",
  "private": true,
  "description": "Source adapters, normalizers, and anomaly checks. Runs in CI, never in the browser.",
  "keywords": [
    "powerlifting",
    "strength-training",
    "etl",
    "data-pipeline",
    "normalization",
    "anomaly-detection"
  ],
  "homepage": "https://platform-toolkit.github.io",
  "bugs": {
    "url": "https://github.com/platform-toolkit/platform-toolkit.github.io/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/platform-toolkit/platform-toolkit.github.io.git",
    "directory": "packages/ingestion"
  },
  "license": "Apache-2.0",
  "author": "Jason Smathers",
  "type": "module",
  "sideEffects": [
    "./dist/bin/*.js"
  ],
  "files": [
