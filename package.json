{
  "name": "platform-toolkit",
  "version": "0.0.0",
  "private": true,
  "description": "Open-source tools for powerlifters and meet directors. Each works alone and embeds anywhere.",
  "license": "MIT",
  "author": "Jason Smathers <jason@smathe.rs>",
  "type": "module",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=11.0.0"
  },
  "packageManager": "pnpm@11.18.0",
  "scripts": {
    "prepare": "node scripts/install-git-hooks.mjs",
    "build": "run-s build:libraries data:emit build:apps",
    "build:libraries": "pnpm --filter \"./packages/**\" run build",
    "build:apps": "pnpm --filter \"./apps/**\" run build",
    "data:emit": "node packages/ingestion/dist/bin/publish-data.js",
    "data:check": "node packages/ingestion/dist/bin/publish-data.js --dry-run",
    "dev": "pnpm --filter @platform-toolkit/web run dev",
    "storybook": "run-s build:libraries storybook:dev",
    "storybook:dev": "storybook dev -p 6006 --no-open",
    "storybook:build": "storybook build --quiet",
    "storybook:smoke": "node scripts/smoke-stories.mjs",
    "storybook:check": "run-s storybook:build storybook:smoke",
    "typecheck": "run-s typecheck:packages typecheck:tests typecheck:tooling typecheck:stories",
    "typecheck:packages": "tsc --build --force",
    "typecheck:tests": "tsc -p tsconfig.tests.json",
    "typecheck:tooling": "tsc -p tsconfig.tooling.json",
    "typecheck:stories": "tsc -p tsconfig.stories.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "scan:references": "node scripts/scan-prohibited-references.mjs",
    "scan:references:strict": "node scripts/scan-prohibited-references.mjs --require-tokens",
    "check:narrow": "node scripts/check-narrow-layout.mjs",
    "verify": "run-s format:check typecheck lint test scan:references build check:narrow storybook:check"
  },
  "devDependencies": {
    "@eslint-community/eslint-plugin-eslint-comments": "4.7.2",
    "@eslint/js": "10.0.1",
    "@storybook/addon-a11y": "10.5.5",
    "@storybook/web-components-vite": "10.5.5",
    "@types/node": "24.13.3",
    "@vitest/browser": "4.1.10",
    "@vitest/browser-playwright": "4.1.10",
    "axe-core": "4.12.1",
    "eslint": "10.8.0",
    "globals": "17.8.0",
    "npm-run-all2": "9.0.3",
    "playwright": "1.62.1",
    "prettier": "3.9.6",
    "storybook": "10.5.5",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0",
    "vitest": "4.1.10"
  }
}
