node_modules/
dist/
dist-types/
*.tsbuildinfo

coverage/
.vitest/
test-results/
playwright-report/
blob-report/
.playwright/
storybook-static/

# Ingestion scratch space: multi-hundred-megabyte source archives and the
# sharded output built from them. Regenerated by CI; never committed.
.cache/
tmp/
apps/web/public/data/

.env
.env.*
!.env.example

# Local-only, per-machine opt-ins for the reference scan. Both are absent for
# everyone but a maintainer who wants them, and the scan imposes nothing when
# they are missing -- outside contributors are unaffected.
#
# The forbidden strings are kept out of version control on purpose: committing
# them, hashed or otherwise, would be the leak the scan exists to prevent.
.prohibited-tokens.local
.commit-identity.local

.DS_Store
*.log
