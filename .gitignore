node_modules/
dist/
dist-types/
*.tsbuildinfo

coverage/
.vitest/
test-results/
playwright-report/
blob-report/
.playwright/
storybook-static/

# Ingestion scratch space: multi-hundred-megabyte source archives and the
# sharded output built from them. Regenerated by CI; never committed.
.cache/
tmp/
apps/web/public/data/

.env
.env.*
!.env.example

# Build-time bill of materials. Generated from the installed tree by
# `pnpm run sbom` and attached to a release, not committed: a checked-in SBOM
# describes whatever tree existed when someone last remembered to regenerate it,
# which is exactly the false assurance the artifact is supposed to remove. The
# durable, reviewable record is docs/dependency-licenses.md, which is committed
# and gated.
sbom.cdx.json

# Local-only, per-machine opt-ins for the reference scan. Both are absent for
# everyone but a maintainer who wants them, and the scan imposes nothing when
# they are missing -- outside contributors are unaffected.
#
# The forbidden strings are kept out of version control on purpose: committing
# them, hashed or otherwise, would be the leak the scan exists to prevent.
.prohibited-tokens.local
.commit-identity.local

# Maintainer working notes: direction given in conversation that is not
# derivable from the code. Local only, and deliberately so -- it exists to
# survive a lost session, not to be published.
#
# `notes/` holds the same kind of thing at length: requirements for tools that
# have not been built yet. Published requirements would read as a commitment,
# and half of what is in them is still a conversation.
/CLAUDE.md
/notes/

# Per-machine editor and agent settings. `.claude/settings.json` is shared if it
# ever exists; the `.local` variant is one maintainer's machine and nobody else's.
.claude/settings.local.json

.DS_Store
*.log

# pnpm writes these on failure or when a store is placed inside the repo.
.pnpm-store/
.pnpm-debug.log*
