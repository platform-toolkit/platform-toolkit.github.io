{
  "$schema": "https://json.schemastore.org/tsconfig",

  // Tests are deliberately excluded from the package projects so that `dist`
  // contains shipped code and nothing else. They still have to be type-checked,
  // though -- an untyped test is a test that can assert the wrong thing without
  // anyone noticing -- so they are checked here instead, with no emit.
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    // `vite/client` declares the side-effect `.css` import. A browser-mode test
    // that measures a tap target has to load the stylesheet the target's size
    // is declared in, or it measures an element with no size rule at all and
    // passes by proving nothing.
    "types": ["node", "vite/client"],

    "noEmit": true,
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "incremental": false,

    // Resolve workspace imports to source rather than to built output, so tests
    // type-check on a clean checkout before anything has been compiled.
    "paths": {
      "@platform-toolkit/configuration": ["./packages/configuration/src/index.ts"],
      "@platform-toolkit/data-access": ["./packages/data-access/src/index.ts"],
      "@platform-toolkit/data-contracts": ["./packages/data-contracts/src/index.ts"],
      "@platform-toolkit/domain": ["./packages/domain/src/index.ts"],
      "@platform-toolkit/ingestion": ["./packages/ingestion/src/index.ts"],
      "@platform-toolkit/preferences": ["./packages/preferences/src/index.ts"],
      "@platform-toolkit/qualification-check": ["./packages/qualification-check/src/index.ts"],
      "@platform-toolkit/qualification-check/core": [
        "./packages/qualification-check/src/core/index.ts"
      ],
      "@platform-toolkit/qualification-check/types": [
        "./packages/qualification-check/src/types.ts"
      ],
      "@platform-toolkit/training-logbook": ["./packages/training-logbook/src/index.ts"],
      "@platform-toolkit/training-logbook/core": ["./packages/training-logbook/src/core/index.ts"],
      "@platform-toolkit/training-logbook/element": [
        "./packages/training-logbook/src/element/index.ts"
      ],
      "@platform-toolkit/training-logbook/storage": [
        "./packages/training-logbook/src/storage/index.ts"
      ],
      "@platform-toolkit/training-logbook/types": ["./packages/training-logbook/src/types.ts"],
      "@platform-toolkit/ui": ["./packages/ui/src/index.ts"]
    }
  },
  // `build-constants.d.ts` is not a test, but a test that reaches the site's
  // composition root pulls in a build-time constant declared only there. Without
  // it the type checker reports an undefined name in application code that the
  // application's own project checks perfectly well.
  // `*.fixture.ts` is test-only for the same reason and excluded from the package
  // projects alongside the tests, so it has to be checked here or a fixture could
  // hand every suite that imports it a value of the wrong shape unchecked.
  "include": [
    "packages/*/src/**/*.test.ts",
    "packages/*/src/**/*.fixture.ts",
    "apps/web/src/**/*.test.ts",
    "apps/web/src/build-constants.d.ts"
  ]
}
